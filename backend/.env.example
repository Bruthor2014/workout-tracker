# ── Opção A: Supabase (ou outro cloud Postgres) ──────────────────────────────
# Vai a Settings → Database → Connection string → Transaction (porta 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Opção B: PostgreSQL local (dev) ──────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=workout_tracker
# DB_USER=postgres
# DB_PASSWORD=a_tua_password

# ── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=muda_isto_para_um_segredo_longo_e_aleatorio

# ── CORS (produção) ──────────────────────────────────────────────────────────
# Opcional: sem isto, a API aceita pedidos de qualquer origem (ok em dev).
# Em produção, lista os domínios do frontend separados por vírgula.
# ALLOWED_ORIGINS=https://inbound.pt,https://www.inbound.pt

# ── Imagens (avatares, fotos de refeições) ───────────────────────────────────
# Opcional: sem isto, as imagens ficam em backend/uploads/ (só funciona com
# um único servidor — ok em dev, não em produção com mais do que uma
# instância). Para usar o Supabase Storage:
#   1. Project Settings → API → copia o "Project URL" e a "service_role" key
#      (NUNCA a "anon" key — essa não tem permissão de escrita no bucket).
#   2. Storage → cria um bucket novo chamado "uploads", marcado como Public.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=a_tua_service_role_key
# SUPABASE_STORAGE_BUCKET=uploads

# ── Email de confirmação (registo) ───────────────────────────────────────────
# Opcional: sem isto, o link de confirmação só aparece no log do servidor (e
# na resposta da API em dev) — dá para testar o registo sem conta de email.
# Para mandar emails a sério, mete as credenciais SMTP (Gmail precisa de uma
# "App Password", não a password normal da conta; outros serviços como
# Mailtrap/SendGrid também dão um SMTP relay).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=o_teu_email@gmail.com
# SMTP_PASS=a_tua_app_password
# EMAIL_FROM=o_teu_email@gmail.com
# URL do frontend, para montar o link de confirmação (?token=...).
FRONTEND_URL=http://localhost:5173

# ── Login/registo com Google ─────────────────────────────────────────────────
# Opcional: sem isto, o botão "Continuar com Google" fica escondido. Para
# ativar: console.cloud.google.com → cria um projeto → APIs & Services →
# Credentials → "OAuth client ID" (tipo "Web application") → Authorized
# JavaScript origins: http://localhost:5173.
# GOOGLE_CLIENT_ID=o_teu_client_id.apps.googleusercontent.com
